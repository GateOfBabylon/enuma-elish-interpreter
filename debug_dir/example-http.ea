executor:
    name: fetch-and-process-items
    type: http
    env:
        api_key: YWRtaW46YWRtaW4=
    tasks:
        - name: fetch-item-list
          export: ${{items}}
          method: GET
          url: http://localhost:8080/api/items
          headers:
            Authorization: Basic ${{api_key}}
        - name: fetch-additional-data-parallel
          parallel:
            - name: fetch-item-details
              export: ${{itemDetails}}
              method: GET
              url: http://localhost:8080/api/items/details
              headers:
                Authorization: Basic ${{api_key}}
                Content-Type: application/json
              body: ${{items}}
            - name: fetch-item-stats
              export: ${{itemsStats}}
              method: GET
              url: http://localhost:8080/api/items/stats
              headers:
                Authorization: Basic ${{api_key}}
        - name: process-details
          method: POST
          url: http://localhost:8080/api/process
          headers:
            Authorization: Bearer ${{api_key}}
            Content-Type: application/json
          body: '{"details":${{itemDetails}}, "stats":${{itemsStats}}}'
        - name: check-status
          method: POST
          url: http://localhost:8080/api/process/status
          headers:
            Authorization: Basic ${{api_key}}
            Content-Type: application/json
          body: ${{itemsStats}}
          export: ${{status}}
          pick:
            if:
                - try: ${{status}} == 'done'
                  export: ${{status}} = 'Http request was successful'
            else:
                export: ${{status}} = 'Http request was NOT successful'